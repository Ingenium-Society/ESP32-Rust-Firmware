CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Board: ESP32-S3 N16R8 (16 MB quad flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Large allocations (KV cache, activations) go to PSRAM; small ones stay in fast internal RAM
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Inference should not run with the small default stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# CPU 160 -> 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Bigger caches (weights stream through the data cache)
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Faster flash: quad I/O at 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
